# Files and folders to exclude from deployment
node_modules/
.git/
.next/cache/
.env.local
.env.example
logs/
drizzle/
coverage/
.vercel/
public/uploads/

# Documentation files
DEPLOYMENT*.md
INTEGRATION_SETUP.md
LINKEDIN_OAUTH_SETUP.md
OAUTH_COMPLETE_SETUP.md
OAUTH_SETUP_GUIDE.md
README.md

# Test and check scripts
check-*.sh
check-*.js
test-*.js
clean-server.sh
restart-dev.sh
setup-ssh*.sh
start-app.sh

# Config files not needed on server
.gitignore
.deployignore
# Note: .htaccess IS deployed (needed for Passenger configuration)
tsconfig.json
tailwind.config.ts
postcss.config.mjs
components.json
next-env.d.ts

# Lock files (keep only package-lock.json)
pnpm-lock.yaml
yarn.lock

# IDE and system files
.vscode/
.idea/
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# Images and zone identifiers
*.png
*.jpg
*.jpeg
*.gif
*.svg
*:Zone.Identifier
